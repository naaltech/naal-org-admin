# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase service role anahtarı (yalnızca sunucuda; Instagram token'ları ve yetki kontrolü için)
SUPABASE_SERVICE_ROLE_KEY=

# Instagram API with Instagram Login (Meta uygulaması › Instagram › API setup with Instagram login)
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
# İsteğe bağlı; boşsa <site adresi>/api/instagram/callback kullanılır. Meta'da kayıtlı adresle aynı olmalı.
INSTAGRAM_REDIRECT_URI=

# Dosya servisi naal-files (Instagram görselleri WebP olarak, sertifika PDF'leri olduğu gibi buraya yüklenir)
FILES_URL=
# Sunucudaki FILES_TOKEN ile aynı değer
FILES_TOKEN=

# Zamanlanmış senkronizasyonun /api/instagram/cron'a gönderdiği gizli anahtar (rastgele uzun bir değer)
CRON_SECRET=

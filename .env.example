# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Catbox userhash (yalnızca sunucuda okunur; NEXT_PUBLIC_ öneki KULLANMAYIN)
CATBOX_USERHASH=

# Cloudflare Turnstile site anahtarı
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Supabase service role anahtarı (yalnızca sunucuda; Instagram token'larını okumak için)
SUPABASE_SERVICE_ROLE_KEY=

# Instagram API with Instagram Login (Meta uygulaması › Instagram › API setup with Instagram login)
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
# İsteğe bağlı; boşsa <site adresi>/api/instagram/callback kullanılır. Meta'da kayıtlı adresle aynı olmalı.
INSTAGRAM_REDIRECT_URI=

# Cloudflare R2 (Instagram görselleri WebP olarak buraya yüklenir)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Bucket'ın herkese açık adresi, ör. https://img.naal.org.tr
R2_PUBLIC_URL=

# Zamanlanmış senkronizasyonun /api/instagram/cron'a gönderdiği gizli anahtar (rastgele uzun bir değer)
CRON_SECRET=
